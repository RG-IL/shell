#!/bin/bash
set -euo pipefail

[[ -f $HOME/.config/caelestia/menu/fzf-theme.sh ]] &&
  source "$HOME/.config/caelestia/menu/fzf-theme.sh"

# caelestia-menu:summary=Pick installed packages (repo + AUR) to remove.
# caelestia-menu:requires-sudo=true

pkg_lines=$(
  {
    pacman -Qn | awk -v OFS="\t" '{print $1, "repo", $2}'
    pacman -Qm | awk -v OFS="\t" '{print $1, "aur", $2}'
  } | sort -u |
    fzf --multi \
      --delimiter='\t' \
      --with-nth=1,3 \
      --preview 'pacman -Qi {1}' \
      --preview-label='alt-p: toggle description, tab: multi-select' \
      --preview-label-pos='bottom' \
      --preview-window 'down:65%:wrap' \
      --bind 'alt-p:toggle-preview' \
      --bind 'tab:toggle'
)

if [[ -z $pkg_lines ]]; then
  exit 0
fi

packages=()
while IFS=$'\t' read -r name _origin _version; do
  [[ -n $name ]] && packages+=("$name")
done <<<"$pkg_lines"

# Both native and foreign packages are tracked in pacman's local database.
sudo pacman -Rns -- "${packages[@]}"
